* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #0F172A;
  color: #f8f1f9;
}

header {
  border-bottom: 1px solid #334155;
  background: #1E293B;
}

nav {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  gap: 10px;
  padding: 16px 20px;
  flex-wrap: wrap;
}

nav button {
  border: 0;
  background: transparent;
  color: #f8f1f9;
  padding: 10px 14px;
  cursor: pointer;
  font-size: 15px;
  border-radius: 6px;
}

nav button:hover,
nav button.ativo {
  background: #EA580C;
}

main {
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 20px;
}

h1 {
  margin-top: 0;
  font-size: 30px;
}

p {
  line-height: 1.6;
}

.acoes {
  margin-top: 24px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.botao {
  border: 1px solid #55334b;
  background: #EA580C;
  color: rgb(217, 225, 226);
  padding: 10px 16px;
  cursor: pointer;
  border-radius: 6px;
}

.botao.secundario {
  background: rgb(254, 254, 254);
  color: #EA580C;
}

form {
  max-width: 500px;
}

.campo {
  margin-bottom: 16px;
}

label {
  display: block;
  font-weight: bold;
  margin-bottom: 6px;
}

input {
  width: 100%;
  padding: 10px;
  border: 1px solid #e2e0e1;
  border-radius: 6px;
  font-size: 15px;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 20px;
}

th, td {
  text-align: left;
  padding: 12px;
  border-bottom: 1px solid #6DA3BD;
}

th {
  background: #334155;
}

.excluir {
  border: 1px solid #EF4444;
  color: #f1f5f9;
  background: rgb(247, 3, 3);
  padding: 7px 10px;
  border-radius: 5px;
  cursor: pointer;
}

.mensagem {
  margin-top: 14px;
  padding: 10px;
  background: #94A3B8;
  border-radius: 6px;
}

.vazio {
  margin-top: 20px;
  padding: 20px;
  border: 1px dashed #e2e0e0;
  border-radius: 6px;
  color: #FFFFFF;
}

.contador {
  margin-top: 10px;
  font-size: 14px;
  color: #ece9ed;
}

.banner {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 10px;
  margin-bottom: 24px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-right: auto; /* empurra os botões pra direita */
  cursor: pointer;
  font-weight: bold;
  font-size: 14px;
  line-height: 1.1;
}

.logo small {
  display: block;
  color: #94A3B8;
  font-weight: normal;
}
